rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'estebanruiz.12vrgassergio@gmail.com';
    }

    function isValidUser(d) {
      return d is map
        && d.keys().hasOnly(['name', 'email', 'createdAt', 'lastLoginAt'])
        && d.name is string && d.name.size() <= 100
        && d.email is string && d.email.size() <= 200
        && d.email == request.auth.token.email
        && d.createdAt is timestamp
        && d.lastLoginAt is timestamp;
    }

    match /settings/{id} {
      allow read, write: if isValidId(id);
    }

    match /services/{id} {
      allow read, write: if isValidId(id);
    }

    match /social_services/{id} {
      allow read, write: if isValidId(id);
    }

    match /news/{id} {
      allow read, write: if isValidId(id);
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLoginAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
